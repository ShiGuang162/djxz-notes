<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-arrow">‹</text>
    </view>
    <text class="nav-title">时光归档</text>
    <view class="nav-share" bindtap="onShare">
      <text class="share-icon">↗</text>
    </view>
  </view>

  <!-- 年份选择器 -->
  <view class="year-selector">
    <view class="year-tabs">
      <view
        wx:for="{{years}}"
        wx:key="*this"
        class="year-tab {{currentYear === item ? 'active' : ''}}"
        bindtap="selectYear"
        data-year="{{item}}"
      >
        <text class="year-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 月份归档列表 -->
  <view class="archive-content" wx:if="{{monthGroups.length > 0}}">
    <view class="month-section" wx:for="{{monthGroups}}" wx:key="month">
      <!-- 月份标题 -->
      <view class="month-header">
        <view class="month-indicator">
          <view class="month-dot"></view>
          <view class="month-line" wx:if="{{index < monthGroups.length - 1}}"></view>
        </view>
        <view class="month-info">
          <text class="month-label">{{item.month}}月</text>
          <text class="month-count">{{item.diaries.length}} 篇日记</text>
        </view>
      </view>

      <!-- 日记条目 -->
      <view class="diary-entries">
        <view
          class="diary-entry"
          wx:for="{{item.diaries}}"
          wx:for-item="diary"
          wx:key="_id"
          bindtap="goToDetail"
          data-id="{{diary._id}}"
        >
          <view class="entry-left">
            <text class="entry-title">{{diary.title || '无标题'}}</text>
            <text class="entry-preview">{{diary.preview}}</text>
          </view>
          <view class="entry-right">
            <text class="entry-date">{{diary.displayDate}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!isLoading && monthGroups.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无归档内容</text>
    <text class="empty-hint">去写点什么吧~</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 底部统计栏 -->
  <view class="stats-footer" wx:if="{{totalDiaries > 0}}">
    <view class="stats-item">
      <text class="stats-num">{{totalWords}}</text>
      <text class="stats-unit">字</text>
    </view>
    <view class="stats-separator">/</view>
    <view class="stats-item">
      <text class="stats-num">{{totalDays}}</text>
      <text class="stats-unit">天</text>
    </view>
    <view class="stats-separator">/</view>
    <view class="stats-item">
      <text class="stats-num">{{activePercent}}</text>
      <text class="stats-unit">%</text>
    </view>
  </view>
</view>

